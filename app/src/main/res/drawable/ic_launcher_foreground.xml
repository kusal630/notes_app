        android:fillColor="#00000000"
        android:strokeColor="#171B24"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M67,37 L57,66" />

    <!-- Nib point: small gold-deep dot at the apex. -->
    <path
        android:fillColor="#B98A1E"
        android:pathData="M54,70 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
